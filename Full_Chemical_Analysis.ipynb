    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "from sklearn.metrics import mean_squared_error\n",
        "\n",
        "donors = [1083, 1368, 1392, 1434, 1118]\n",
        "doses = [0.1, 1.0, 10.0, 100.0]\n",
        "\n",
        "def window_nrmse_plot_full_signal(drugname, window_size):\n",
        "    encoded_data = autoencoder.encoder(X_treated).numpy()\n",
        "    decoded_data = autoencoder.decoder(encoded_data).numpy()\n",
        "\n",
        "    n_rows = len(doses)\n",
        "    n_cols = len(donors)\n",
        "    fig, axes = plt.subplots(n_rows, n_cols, figsize=(4*n_cols, 3*n_rows), sharex=True, sharey=True)\n",
        "\n",
        "    if n_rows > 1 or n_cols > 1:\n",
        "        axes = axes.flatten()\n",
        "    else:\n",
        "        axes = [axes]\n",
        "\n",
        "    chemical_classification = treated_df[treated_df['Drugname'] == drugname]['Chemical Classification'].iloc[0]\n",
        "\n",
        "    for r, dose in enumerate(doses):\n",
        "        for c, donor in enumerate(donors):\n",
        "            ax_idx = r * n_cols + c\n",
        "            ax = axes[ax_idx]\n",
        "\n",
        "            filtered = treated_df[\n",
        "                (treated_df[\"Donor\"] == donor) &\n",
        "                (treated_df[\"Drugname\"] == drugname) &\n",
        "                (treated_df[\"Dose\"] == dose)\n",
        "            ]\n",
        "\n",
        "            if filtered.empty:\n",
        "                ax.axis('off')  # leave blank if no data\n",
        "                continue\n",
        "\n",
        "            row = filtered.iloc[0]\n",
        "            row_idx = treated_df.index.get_loc(row.name)\n",
        "            signal = X_treated.iloc[row_idx]\n",
        "            reconstructed = decoded_data[row_idx]\n",
        "\n",
        "\n",
        "            n_windows = signal.shape[0] // window_size\n",
        "            nrmse = []\n",
        "            for w in range(n_windows):\n",
        "                start = w * window_size\n",
        "                end = start + window_size\n",
        "                rmse = np.sqrt(mean_squared_error(signal[start:end], reconstructed[start:end]))\n",
        "                window_range = np.max(signal[start:end]) - np.min(signal[start:end])\n",
        "                normalized_rmse = rmse / window_range\n",
        "                nrmse.append(normalized_rmse)\n",
        "\n",
        "            avg_nrmse = np.mean(nrmse)\n",
        "\n",
        "\n",
        "            ax.plot(signal, 'b', label=\"Input\")\n",
        "            ax.plot(reconstructed, 'r', label=\"Reconstruction\")\n",
        "\n",
        "\n",
        "            if r == 0: # First row gets Donor name and NRMSE\n",
        "                ax.set_title(f'Donor {donor}\\nNRMSE={avg_nrmse:.3f}', fontsize=12)\n",
        "            else: # Other rows only get NRMSE\n",
        "                ax.set_title(f'NRMSE={avg_nrmse:.3f}', fontsize=12)\n",
        "\n",
        "            # Remove individual axis labels\n",
        "            ax.set_xlabel('')\n",
        "            ax.set_ylabel('')\n",
        "\n",
        "            if c == 0:\n",
        "                ax.text(-0.2, 0.5, f'{dose} µM', transform=ax.transAxes, fontsize=12, ha='right', va='center')\n",
        "\n",
        "\n",
        "    handles, labels = axes[0].get_legend_handles_labels()\n",
        "    ax.set_xticks([])\n",
        "    fig.legend(handles, labels, loc=\"lower right\")\n",
        "\n",
        "\n",
        "    plt.suptitle(f'{drugname} ({chemical_classification})', fontsize=16,)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n"
      ],
