    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "grouped_counts = ex_cipa_new_output_df.groupby(['Chemical Classification', 'Donor', 'toxicity']).size().reset_index(name='count')\n",
        "\n",
        "grouped_counts['proportion'] = grouped_counts.groupby(['Chemical Classification', 'Donor'])['count'].transform(lambda x: x / x.sum())\n",
        "\n",
        "toxicity_proportions_df = grouped_counts.pivot_table(\n",
        "    index=['Chemical Classification', 'Donor'],\n",
        "    columns='toxicity',\n",
        "    values='proportion',\n",
        "    fill_value=0\n",
        ").reset_index()\n",
        "\n",
        "required_columns = ['Chemical Classification', 'Donor', 'highly toxic', 'medium toxic', 'nontoxic']\n",
        "for level in ['highly toxic', 'medium toxic', 'nontoxic']:\n",
        "    if level not in toxicity_proportions_df.columns:\n",
        "        toxicity_proportions_df[level] = 0.0\n",
        "\n",
        "toxicity_proportions_df = toxicity_proportions_df[required_columns]\n",
        "\n",
        "display(toxicity_proportions_df.head())\n",
        "print(f\"Shape of toxicity_proportions_df: {toxicity_proportions_df.shape}\")\n",
        "\n",
        "pivot_df = toxicity_proportions_df.set_index(\n",
        "    ['Chemical Classification', 'Donor']\n",
        ")[['highly toxic', 'medium toxic', 'nontoxic']]\n",
        "\n",
        "chemical_classes = pivot_df.index.get_level_values(0).unique()\n",
        "donors = pivot_df.index.get_level_values(1).unique()\n",
        "\n",
        "sample_sizes_per_classification = (\n",
        "    ex_cipa_new_output_df\n",
        "    .groupby('Chemical Classification')['Chemical Name']\n",
        "    .nunique()\n",
        "    .to_dict()\n",
        ")\n",
        "\n",
        "total_samples_per_donor_chem_class = (\n",
        "    ex_cipa_new_output_df\n",
        "    .groupby(['Chemical Classification', 'Donor'])\n",
        "    .size()\n",
        "    .reset_index(name='total_samples')\n",
        ")\n",
        "\n",
        "group_spacing = 2.8\n",
        "y = np.arange(len(chemical_classes)) * group_spacing\n",
        "\n",
        "n_donors = len(donors)\n",
        "bar_height = 0.4\n",
        "donor_spacing = 1\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(12, 14))\n",
        "\n",
        "toxicity_colors = {\n",
        "    'highly toxic': '#d62728',\n",
        "    'medium toxic': '#ff7f0e',\n",
        "    'nontoxic': '#2ca02c'\n",
        "}\n",
        "\n",
        "for i, donor in enumerate(donors):\n",
        "    donor_data = pivot_df.xs(donor, level='Donor').reindex(chemical_classes)\n",
        "\n",
        "    offset = (i - (n_donors - 1) / 2) * bar_height * donor_spacing\n",
        "    left = np.zeros(len(chemical_classes))\n",
        "\n",
        "    for tox in ['highly toxic', 'medium toxic', 'nontoxic']:\n",
        "        values = donor_data[tox].values\n",
        "\n",
        "        ax.barh(\n",
        "            y + offset,\n",
        "            values,\n",
        "            bar_height,\n",
        "            left=left,\n",
        "            color=toxicity_colors[tox],\n",
        "            edgecolor='black',\n",
        "            linewidth=0.8\n",
        "        )\n",
        "\n",
        "        left += values\n",
        "\n",
        "    for j in range(len(chemical_classes)):\n",
        "        ax.text(\n",
        "            1.01,\n",
        "            y[j] + offset,\n",
        "            str(donor),\n",
        "            va='center',\n",
        "            ha='left',\n",
        "            fontsize=8,\n",
        "            clip_on=False\n",
        "        )\n",
        "\n",
        "ax.set_yticks(y)\n",
        "ax.set_yticklabels([\n",
        "    f'{chem_class}\\n(n={sample_sizes_per_classification.get(chem_class, 0)})'\n",
        "    for chem_class in chemical_classes\n",
        "])\n",
        "\n",
        "ax.set_xlim(0, 1.08)\n",
        "ax.set_xlabel('Proportion of Samples')\n",
        "ax.set_ylabel('Chemical Classification')\n",
        "ax.set_title('Toxicity Proportion by ToxCast Chemical Class and Donor')\n",
        "\n",
        "ax.spines['top'].set_visible(False)\n",
        "ax.spines['right'].set_visible(False)\n",
        "\n",
        "plt.subplots_adjust(right=0.84)\n",
        "plt.show()"
      ],
