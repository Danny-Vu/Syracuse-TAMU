    {
      "cell_type": "code",
      "source": [
        "chi_df = ex_cipa_new_output_df[['Donor','File','toxicity']]\n",
        "chi_df\n",
        "from scipy.stats import chi2_contingency\n",
        "\n",
        "contingency = pd.crosstab(chi_df['Donor'], chi_df['toxicity'])\n",
        "\n",
        "print(\"Contingency Table:\")\n",
        "print(contingency)\n",
        "\n",
        "chi2, p, dof, expected = chi2_contingency(contingency)\n",
        "\n",
        "print(f\"\\nChi-square statistic: {chi2:.4f}\")\n",
        "print(f\"Degrees of freedom: {dof}\")\n",
        "print(f\"P-value: {p:.6f}\")\n",
        "\n",
        "percentages = contingency.div(contingency.sum(axis=1), axis=0) * 100\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.pcolor(percentages, cmap='Blues')\n",
        "plt.xticks(np.arange(0.5, len(percentages.columns)), percentages.columns, rotation=45)\n",
        "plt.yticks(np.arange(0.5, len(percentages.index)), percentages.index)\n",
        "\n",
        "for i in range(len(percentages.index)):\n",
        "    for j in range(len(percentages.columns)):\n",
        "        value = percentages.iloc[i, j]\n",
        "        plt.text(j + 0.5, i + 0.5, f\"{value:.1f}%\", ha='center', va='center')\n",
        "\n",
        "plt.colorbar(label=\"Percentage (%)\")\n",
        "plt.title(\"Toxicity Distribution per Donor\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "if p < 0.05:\n",
        "    print(f\"\\nSignificant donor differences detected (p={p:.4f})\")\n",
        "else:\n",
        "    print(f\"\\nNo significant donor differences detected (p={p:.4f})\")\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "\n",
        "donors = [1083, 1368, 1392, 1118, 1434]\n",
        "\n",
        "colors = ['#d62728', '#ff7f0e', '#2ca02c']\n",
        "\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(8, 6))\n",
        "\n",
        "bar_height = 0.5\n",
        "y_positions = np.arange(len(donors))\n",
        "\n",
        "for i, donor in enumerate(donors):\n",
        "    donor_data = chi_df[chi_df['Donor'] == donor]\n",
        "    counts = donor_data['toxicity'].value_counts()\n",
        "    for group in chi_df['toxicity'].unique():\n",
        "        if group not in counts:\n",
        "            counts[group] = 0\n",
        "\n",
        "    counts = counts[sorted(counts.index)]\n",
        "    total = counts.sum()\n",
        "    left = 0\n",
        "    for j, group in enumerate(counts.index):\n",
        "        proportion = counts[group] / total\n",
        "        ax.barh(y=i, width=proportion, left=left, height=bar_height, color=colors[j], label=group if i == 0 else \"\")\n",
        "        if proportion > 0:\n",
        "            ax.text(left + proportion / 2, i, f\"{proportion*100:.1f}%\", ha='center', va='center', color='white', fontsize=10)\n",
        "        left += proportion\n",
        "\n",
        "ax.set_yticks(y_positions)\n",
        "ax.set_yticklabels(donors)\n",
        "ax.set_xlabel(\"Proportion of Samples\")\n",
        "ax.set_title(\"Toxicity Distribution per Donor [ToxCast Chemicals without Plate 16]\")\n",
        "ax.legend(title=\"Toxicity\", bbox_to_anchor=(1.05, 1))\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "vulnerability_score = chi_df.groupby('Donor')['toxicity'].apply(\n",
        "    lambda x: x.apply(lambda val: 2 if val == 'highly toxic' else (1 if val == 'medium toxic' else 0)).sum() / (len(x) * 2))\n",
        "\n",
        "print(vulnerability_score)"
      ],
